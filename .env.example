# Copy this file to .env and replace placeholder values as needed.

CHUNKING_EMBED_MODEL=all-MiniLM-L6-v2
CHUNKING_LLM_MODEL=gemini-2.5-flash
GEMINI_API_KEY=
APP_ENV=development

# LLM Sampling Parameters for Agentic Chunking
# top_p: Controls diversity via nucleus sampling (0.0 to 1.0). Default: 1.0
# top_k: Limits sampling to top k tokens (0 disables). Default: 0
CHUNKING_LLM_TOP_P=1.0
CHUNKING_LLM_TOP_K=0

# Optional AWS configuration for loading documents directly from S3
# Used when submitting s3://bucket/key input from the UI/API.
AWS_REGION=us-east-1
AWS_PROFILE=default
